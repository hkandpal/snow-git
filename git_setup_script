create database git;
create schema git_schema;


create or replace secret git_secret
type=PASSWORD
username='hkandpal'
password='';



CREATE or replace  API INTEGRATION   GIT_INIT
  API_PROVIDER = GIT_HTTPS_API
  API_ALLOWED_PREFIXES = ('https://github.com/hkandpal/snow-git')
  ENABLED = TRUE
  ALLOWED_AUTHENTICATION_SECRETS  = (git_secret);

DESC INTEGRATION GIT_INIT;


CREATE OR REPLACE GIT REPOSITORY snowflakescripts
  API_INTEGRATION = GIT_INIT
  GIT_CREDENTIALS = git_secret
  ORIGIN = 'https://github.com/hkandpal/snow-git';

  --testing
 
-- ** TO see the Git repo and if the following 
-- 1) ONce you see all the repos by using the command LIST @git.git_schema.my_local_stage;
-- 2) Then select the + sign and Select Create new Git repo


CREATE STAGE IF NOT EXISTS git.git_schema.my_local_stage;
SHOW STAGES IN SCHEMA git.git_schema;
ALTER GIT REPOSITORY git.git_schema.snowflakescripts FETCH;
LIST @git.git_schema.snowflakescripts/branches/main;
COPY FILES   INTO @git.git_schema.my_local_stage/   FROM @git.git_schema.snowflakescripts/branches/main/;
LIST @git.git_schema.my_local_stage;

